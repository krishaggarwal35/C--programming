#include<stdio.h>
struct Student {
    char name[50];
    int roll_no;
    float marks;
};
int main() {
    struct Student s1;
    printf("enter name: ");
    scanf("%s",s1.name);
    printf("enter roll number: ");
    scanf("%d",&s1.roll_no);
    printf("enter marks: ");
    scanf("%f",&s1.marks);
    printf("\nStudent information\n");
    printf("name: %s\n",s1.name);
    printf("roll no: %d\n",s1.roll_no);
    printf("marks :% 2.f\n",s1.marks);
    return 0;
    
}
